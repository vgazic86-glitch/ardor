{
  "name": "dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:node": "DEPLOY_TARGET=node vite build",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "start": "node scripts/migrate.mjs && srvx serve --prod --entry dist/server/server.js --static ../client --port ${PORT:-3000}",
    "start:lokalno": "node --env-file-if-exists=.env scripts/migrate.mjs && node --env-file-if-exists=.env node_modules/srvx/bin/srvx.mjs serve --prod --entry dist/server/server.js --static ../client --port 3000"
  },
  "dependencies": {
    "@netlify/database": "^2.0.3",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "chart.js": "4.6.1",
    "drizzle-orm": "1.0.0-beta.22",
    "lucide-react": "1.61.0",
    "pdf-lib": "^1.17.1",
    "pg": "8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-chartjs-2": "5.3.1",
    "react-dom": "19.3.1",
    "srvx": "1.0.8",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@netlify/vite-plugin-tanstack-start": "1.3.19",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "1.0.0-beta.22",
    "jsdom": "29.1.1",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  }
}
