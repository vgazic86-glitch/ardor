# Kopiraj u .env i upiši svoje vrijednosti. .env se NE commita.
# pnpm dev / pnpm migrate / pnpm start:lokalno čitaju ovu datoteku same.

# Lokalni Postgres (NE produkcijska baza s Rendera)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ardor

# Neobavezno
# ADMIN_LOZINKA=
# SESSION_SECRET=
# GEMINI_API_KEY=           # AI asistent (Google AI Studio). Upisuje Vladimir; ne commitati.
# GEMINI_MODEL=gemini-flash-lite-latest

# Sedmični izvještaj e-poštom (ponedjeljak 7:00). Na Renderu upisuje Vladimir.
# RESEND_API_KEY=            # ključ s resend.com (domena ardornamjestaj.com mora biti potvrđena)
# IZVJESTAJ_TOKEN=           # dugi slučajni niz; ISTI i u GitHub → Settings → Secrets → Actions
# IZVJESTAJ_OD=ARDOR izvještaji <izvjestaji@ardornamjestaj.com>
# APP_URL=https://ardor-4mdu.onrender.com
# RESEND_API_URL=http://localhost:4010   # SAMO lokalni test s lažnim serverom
